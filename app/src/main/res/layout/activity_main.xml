<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/background" android:fillViewport="true" tools:context=".MainActivity">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="20dp" android:paddingBottom="24dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/app_name"
            android:textSize="28sp" android:textStyle="bold" android:textColor="@color/text_primary" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
            android:text="@string/supported_platforms" android:textAppearance="@style/TextAppearance.VGet.Body" />
        <com.google.android.material.card.MaterialCardView android:id="@+id/inputCard" style="@style/Widget.VGet.Card"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/input_section"
                    android:textAppearance="@style/TextAppearance.VGet.Section" />
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/urlInputLayout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
                    android:hint="@string/enter_video_url" android:textColorHint="@color/text_secondary"
                    app:boxStrokeColor="@color/outline_color" app:hintTextColor="@color/text_secondary"
                    app:boxCornerRadiusTopStart="12dp" app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp" app:boxCornerRadiusBottomEnd="12dp" app:endIconMode="clear_text">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/urlEditText"
                        android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="80dp"
                        android:inputType="textUri|textMultiLine" android:maxLines="3" android:gravity="top|start"
                        android:textSize="16sp" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" />
                </com.google.android.material.textfield.TextInputLayout>
                <LinearLayout android:id="@+id/inputActions" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:orientation="horizontal" android:baselineAligned="false" android:gravity="center_vertical">
                    <com.google.android.material.button.MaterialButton android:id="@+id/pasteButton" style="@style/Widget.VGet.Button.Secondary"
                        android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp" android:text="@string/paste" android:paddingStart="12dp" android:paddingEnd="12dp" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/downloadButton" style="@style/Widget.VGet.Button.Primary"
                        android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                        android:text="@string/analyze_quality" android:paddingStart="12dp" android:paddingEnd="12dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView android:id="@+id/qualityCard" style="@style/Widget.VGet.Card"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:visibility="gone" tools:visibility="visible">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/quality_section"
                    android:textAppearance="@style/TextAppearance.VGet.Section" />
                <TextView android:id="@+id/videoTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:maxLines="3" android:ellipsize="end" android:textSize="16sp"
                    android:textColor="@color/text_primary" tools:text="影片標題" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"
                    android:text="@string/choose_quality" android:textAppearance="@style/TextAppearance.VGet.Body" android:labelFor="@id/qualitySpinner" />
                <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                    android:background="@drawable/quality_selector_background">
                    <Spinner android:id="@+id/qualitySpinner" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:minHeight="80dp" android:paddingEnd="32dp" android:paddingStart="0dp"
                        android:background="@android:color/transparent" android:spinnerMode="dialog" android:prompt="@string/choose_quality"
                        app:popupTheme="@style/ThemeOverlay.VGet.Dialog" />
                    <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="12dp" android:src="@drawable/ic_expand_more" android:importantForAccessibility="no" />
                </FrameLayout>
                <TextView android:id="@+id/qualityHint" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:textAppearance="@style/TextAppearance.VGet.Body" android:text="@string/choose_quality_hint" />
                <com.google.android.material.button.MaterialButton android:id="@+id/downloadSelectedButton" style="@style/Widget.VGet.Button.Primary"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/download_selected" />
                <com.google.android.material.button.MaterialButton android:id="@+id/previewButton" style="@style/Widget.VGet.Button.Secondary"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/preview_selected" />
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp" android:background="@color/divider" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/audio_section"
                    android:textAppearance="@style/TextAppearance.VGet.Section" />
                <TextView android:id="@+id/mp3Hint" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:textAppearance="@style/TextAppearance.VGet.Body" android:lineSpacingExtra="3dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/downloadMp3Button" style="@style/Widget.VGet.Button.Secondary"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/download_mp3" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView android:id="@+id/progressCard" style="@style/Widget.VGet.Card"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/status_ready" android:textAppearance="@style/TextAppearance.VGet.Section" android:accessibilityLiveRegion="polite" />
                <ProgressBar android:id="@+id/progressBar" style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
                    android:progressTint="@color/primary" android:progressBackgroundTint="@color/divider" android:indeterminateTint="@color/primary"
                    android:max="100" android:progress="0" />
                <TextView android:id="@+id/progressText" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:textSize="16sp" android:textColor="@color/text_primary" tools:text="100%" />
                <com.google.android.material.button.MaterialButton android:id="@+id/cancelButton" style="@style/Widget.VGet.Button.Secondary"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/cancel" />
                <com.google.android.material.button.MaterialButton android:id="@+id/playDownloadedButton" style="@style/Widget.VGet.Button.Secondary"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                    android:visibility="gone" android:text="@string/play_downloaded" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView android:id="@+id/infoCard" style="@style/Widget.VGet.Card"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/help_section"
                    android:textAppearance="@style/TextAppearance.VGet.Section" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                    android:text="@string/usage_instructions" android:textAppearance="@style/TextAppearance.VGet.Body" android:lineSpacingExtra="4dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                    android:text="@string/engine_hint" android:textAppearance="@style/TextAppearance.VGet.Body" android:lineSpacingExtra="4dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/updateEngineButton" style="@style/Widget.VGet.Button.Text"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/update_engine" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
